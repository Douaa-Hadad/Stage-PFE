# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Generated data files (re-created by setup.py) ────────────────────────────
# All CSV data — generated by the pipeline scripts
hospital_microgrid/data/

# Keep .gitkeep files so empty folders are visible in git
!hospital_microgrid/data/**/.gitkeep

# ── Generated model files ─────────────────────────────────────────────────────
# Preprocessing arrays and scalers (very large)
hospital_microgrid/models/preprocessing/

# Trained model weights (large binary files)
hospital_microgrid/models/trained/

# Evaluation artefacts
hospital_microgrid/models/evaluation/

# Catch-all for any stray large ML binary formats
*.npy
*.h5
*.pkl

# ── Hardhat generated files ───────────────────────────────────────────────────
node_modules/
artifacts/
cache/
hospital_microgrid/node_modules/
hospital_microgrid/artifacts/
hospital_microgrid/cache/

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Environment & logs ────────────────────────────────────────────────────────
.env
*.log
bridge_log.txt
